# =============================================================================
# Lyricly — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# Site URL — used for canonical URLs, OG tags, and sitemap
# Change this to your production domain before deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LRCLIB API base URL — only change if you're proxying the API
NEXT_PUBLIC_LRCLIB_BASE_URL=https://lrclib.net

# =============================================================================
# Optional: Firebase Authentication
# Uncomment and fill in if you enable Firebase Auth
# =============================================================================
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# =============================================================================
# Optional: Google Search Console verification
# =============================================================================
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
